# ─────────────────────────────────────────────────────────────
# Jobs Overseas — Environment Variables (NAMES ONLY, no values)
# Copy this file to .env.local for local development and fill
# in real values there. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── SERVER-ONLY (never sent to the browser, never prefixed NEXT_PUBLIC_) ──
# Used only inside API routes / server components / server actions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── BROWSER-SAFE (bundled into client JS — must NOT be secrets) ──
# The anon key is safe to expose because Row Level Security (RLS)
# enforces what it can actually do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── APP CONFIG ──
NEXT_PUBLIC_SITE_URL=
NODE_ENV=
